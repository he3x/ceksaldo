# ==================== WHATSAPP CONFIGURATION ====================
# ID Grup WhatsApp untuk notifikasi (dapatkan dari bot saat pertama kali run)
WA_GROUP_ID=

# ==================== MONITORING CONFIGURATION ====================
# Interval pengecekan berkala (dalam menit)
# Contoh: 10 = cek setiap 10 menit
CHECK_INTERVAL_MINUTES=10

# Threshold saldo minimum (dalam Rupiah)
# Jika saldo < threshold, auto-deposit akan dijalankan
MIN_SALDO_THRESHOLD=1000000

# Nominal deposit otomatis (dalam Rupiah)
DEPOSIT_AMOUNT=10000000

# ==================== FEATURE FLAGS ====================
# Enable/disable auto-deposit untuk masing-masing platform
LAPAK_AUTO_DEPOSIT_ENABLED=true
VEXA_AUTO_DEPOSIT_ENABLED=true

# Enable/disable monitoring untuk masing-masing platform
LAPAK_MONITORING_ENABLED=true
VEXA_MONITORING_ENABLED=true

# ==================== LAPAKGAMING CONFIGURATION ====================
# Kredensial login Lapakgaming
LAPAK_USER=your_email@example.com
LAPAK_PASS=your_password

# Cookie sesi Lapakgaming (akan diupdate otomatis oleh auto-login)
LAPAK_COOKIE=your_cookie_here

# Secret key untuk 2FA Google Authenticator Lapakgaming
LAPAK_2FA_SECRET=your_2fa_secret_key

# Payment method untuk Lapakgaming (VA_BCA, TF_BCA_B2B, VA_MANDIRI_XE, dll)
LAPAK_PAYMENT_METHOD=VA_BCA

# ==================== VEXAAGEN CONFIGURATION ====================
# Kredensial login Vexaagen API
VEXA_USER=your_email@example.com
VEXA_PASS=your_password

# Payment method ID untuk Vexaagen (5 = BCA Manual)
VEXA_PAYMENT_METHOD_ID=5

# ==================== CAPTCHA SOLVER CONFIGURATION ====================
# API Key untuk SolveCaptcha.com (untuk bypass reCAPTCHA Lapakgaming)
SOLVECAPTCHA_KEY=your_solvecaptcha_api_key

# ==================== ADVANCED CONFIGURATION ====================
# Lapakgaming URLs
LAPAK_LOGIN_URL=https://www.lapakgaming.com/auth/login
LAPAK_DASHBOARD_URL=https://www.lapakgaming.com/reseller/
LAPAK_DEPOSIT_URL=https://www.lapakgaming.com/reseller/deposit/new_international
LAPAK_SITEKEY=6LfpQvMgAAAAAG8jTpjLTrJ0AHAYZf8AW6te3mDA

# Vexaagen API Base URL
VEXA_API_BASE_URL=https://api.vexaagen.com

# SolveCaptcha API URLs
SOLVECAPTCHA_IN_URL=http://api.solvecaptcha.com/in.php
SOLVECAPTCHA_RES_URL=http://api.solvecaptcha.com/res.php

# Timing Configuration (dalam milidetik)
CAPTCHA_POLL_INTERVAL=5000
CAPTCHA_MAX_ATTEMPTS=24